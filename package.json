{
  "name": "trancycle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && node scripts/validate-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "test": "node --test",
    "import:airtable": "node scripts/import-airtable.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.131.1",
    "yaml": "2.9.1"
  }
}
