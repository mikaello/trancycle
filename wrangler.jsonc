{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trancycle",
  "compatibility_date": "2026-09-13",
  // Keep production on the final custom domain while allowing pull-request previews.
  "workers_dev": false,
  "preview_urls": true,
  // Keep observability on Cloudflare's included native dashboard services.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
