---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  allSearchText,
  byPreferredTerm,
  preferredTerm,
  termHref,
} from "../lib/terms";

const terms = (await getCollection("terms")).sort(byPreferredTerm("en"));
const domains = [...new Set(terms.flatMap((entry) => entry.data.domains))].sort(
  (a, b) => a.localeCompare(b, "nb"),
);
const termSetData = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "Trancycle",
  description: "Engelsk–norsk ordliste for sykling.",
  hasDefinedTerm: terms.map((entry) => ({
    "@type": "DefinedTerm",
    name: preferredTerm(entry, "en"),
    inDefinedTermSet: "/",
    url: termHref(entry),
  })),
};
---

<BaseLayout structuredData={termSetData}>
  <section class="intro shell">
    <div class="eyebrow">
      <span>EN</span>
      <i></i>
      <span>NB</span>
    </div>
    <h1>
      Finn ordene som
      <br />
      holder sykkelen sammen.
    </h1>
    <p>
      Engelske og norske sykkelbegrep, samlet for mekanikere, syklister og
      oversettere.
    </p>
  </section>

  <section class="glossary shell" aria-labelledby="glossary-heading">
    <div class="search-panel">
      <label for="term-search" id="glossary-heading">
        Søk i ordlisten
      </label>
      <div class="search-field">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 5 5"></path>
        </svg>
        <input
          id="term-search"
          type="search"
          placeholder="Søk på engelsk eller norsk …"
          autocomplete="off"
        />
        <kbd>/</kbd>
      </div>
      <div class="filters">
        <label>
          <span>Sorter etter</span>
          <select id="sort-language">
            <option value="en">English</option>
            <option value="nb">Norsk</option>
          </select>
        </label>
        <label>
          <span>Område</span>
          <select id="domain-filter">
            <option value="">Alle områder</option>
            {domains.map((domain) => (
              <option value={domain}>{domain}</option>
            ))}
          </select>
        </label>
        <button class="clear-button" id="clear-search" type="button">
          Nullstill
        </button>
      </div>
      <noscript>
        <p class="noscript">
          Søk krever JavaScript, men hele ordlisten vises under.
        </p>
      </noscript>
    </div>

    <div class="result-meta">
      <p>
        <strong id="result-count">{terms.length}</strong>{" "}
        <span id="result-label">begrep</span>
      </p>
      <span>Oppdatert 13.09.2026</span>
    </div>

    <div class="term-list" aria-label="Sykkelbegrep">
      <div class="term-list__header" aria-hidden="true">
        <span>English</span>
        <span>Norsk bokmål</span>
        <span>Område</span>
        <span aria-hidden="true"></span>
      </div>
      <ol>
        {terms.map((entry, index) => (
          <li
            class="term-row"
            data-term-row
            data-en={preferredTerm(entry, "en")}
            data-nb={preferredTerm(entry, "nb")}
            data-domains={entry.data.domains.join("|")}
            data-search={allSearchText(entry)}
          >
            <span class="term-row__number" aria-hidden="true">
              {String(index + 1).padStart(3, "0")}
            </span>
            <a
              href={termHref(entry)}
              class="term-row__link"
              aria-label={`${preferredTerm(entry, "en")}, ${preferredTerm(entry, "nb")}`}
            >
              <strong data-label="English">{preferredTerm(entry, "en")}</strong>
              <span data-label="Norsk bokmål">
                {preferredTerm(entry, "nb")}
              </span>
              <span class="term-row__domain" data-label="Område">
                {entry.data.domains.join(" · ")}
              </span>
              <span class="term-row__arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="empty-state" id="empty-state" hidden>
        Ingen treff ennå.
        <br />
        <a href="https://github.com/mikaello/trancycle/issues/new?template=new-term.yml">
          Foreslå begrepet ↗
        </a>
      </p>
    </div>
  </section>

  <section class="contribute shell">
    <p class="section-number">02 / BIDRA</p>
    <div>
      <h2>Mangler det et ord?</h2>
      <p>
        Du trenger ikke kunne Git eller YAML. Beskriv begrepet og konteksten, så
        hjelper vi det inn i ordlisten.
      </p>
    </div>
    <a
      class="button"
      href="https://github.com/mikaello/trancycle/issues/new?template=new-term.yml"
    >
      Foreslå nytt begrep <span>↗</span>
    </a>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("#term-search")!;
    const sort = document.querySelector<HTMLSelectElement>("#sort-language")!;
    const domain = document.querySelector<HTMLSelectElement>("#domain-filter")!;
    const clear = document.querySelector<HTMLButtonElement>("#clear-search")!;
    const list = document.querySelector<HTMLOListElement>(".term-list ol")!;
    const count = document.querySelector<HTMLElement>("#result-count")!;
    const empty = document.querySelector<HTMLElement>("#empty-state")!;
    const rows = [...document.querySelectorAll<HTMLElement>("[data-term-row]")];

    const normalize = (value: string) =>
      value.normalize("NFKC").toLocaleLowerCase("nb").trim();
    const params = new URLSearchParams(location.search);
    search.value = params.get("q") ?? "";
    sort.value = params.get("sort") === "nb" ? "nb" : "en";
    domain.value = params.get("domain") ?? "";

    const update = () => {
      const query = normalize(search.value);
      const selectedDomain = domain.value;
      const sortLanguage = sort.value as "en" | "nb";
      const collator = new Intl.Collator(sortLanguage, { sensitivity: "base" });

      const rank = (row: HTMLElement) => {
        if (!query) return 0;
        const preferred = [row.dataset.en, row.dataset.nb].map((value) =>
          normalize(value ?? ""),
        );
        if (preferred.includes(query)) return 0;
        if (preferred.some((value) => value.startsWith(query))) return 1;
        return 2;
      };

      rows
        .sort((a, b) => {
          const rankDifference = rank(a) - rank(b);
          return (
            rankDifference ||
            collator.compare(
              a.dataset[sortLanguage] ?? "",
              b.dataset[sortLanguage] ?? "",
            )
          );
        })
        .forEach((row, index) => {
          list.append(row);
          const number = row.querySelector<HTMLElement>(".term-row__number");
          if (number) number.textContent = String(index + 1).padStart(3, "0");
        });

      let visible = 0;
      rows.forEach((row) => {
        const matchesText =
          !query || normalize(row.dataset.search ?? "").includes(query);
        const matchesDomain =
          !selectedDomain ||
          (row.dataset.domains ?? "").split("|").includes(selectedDomain);
        row.hidden = !(matchesText && matchesDomain);
        if (!row.hidden) visible += 1;
      });

      count.textContent = String(visible);
      empty.hidden = visible !== 0;
      clear.hidden = !query && !selectedDomain && sortLanguage === "en";

      const nextParams = new URLSearchParams();
      if (query) nextParams.set("q", search.value.trim());
      if (sortLanguage !== "en") nextParams.set("sort", sortLanguage);
      if (selectedDomain) nextParams.set("domain", selectedDomain);
      const nextUrl = nextParams.size
        ? `${location.pathname}?${nextParams}`
        : location.pathname;
      history.replaceState({}, "", nextUrl);
    };

    search.addEventListener("input", update);
    sort.addEventListener("change", update);
    domain.addEventListener("change", update);
    clear.addEventListener("click", () => {
      search.value = "";
      sort.value = "en";
      domain.value = "";
      search.focus();
      update();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== search) {
        event.preventDefault();
        search.focus();
      }
    });
    update();
  </script>
</BaseLayout>
