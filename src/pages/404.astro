---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/terms";
---

<BaseLayout title="Fant ikke siden — Trancycle">
  <section class="not-found shell">
    <p class="section-number">404</p>
    <h1>Siden finnes ikke.</h1>
    <p>Gå tilbake til ordlisten.</p>
    <a class="button" href={sitePath("/")}>
      Tilbake til ordlisten <span>↗</span>
    </a>
  </section>
</BaseLayout>
